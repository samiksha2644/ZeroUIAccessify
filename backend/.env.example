# .env.example

# OpenAI API Key for Whisper and TTS
OPENAI_API_KEY="sk-..."

# Google Maps API Key for Places, Directions, and Routes
GOOGLE_MAPS_API_KEY="AIza..."

# Absolute or relative path to your Firebase Service Account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"

# URL of your Firebase Realtime Database
FIREBASE_REALTIME_DB_URL="https://your-project-id.firebaseio.com"
