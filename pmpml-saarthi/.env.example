# Path to your Firebase service account JSON key file
FIREBASE_CREDENTIALS_PATH=./firebase/firebase-credentials.json

# Google Maps API key (for geocoding / directions — optional for MVP)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend URL the mobile app connects to (use your machine's LAN IP for Expo Go)
BACKEND_URL=http://localhost:8000
